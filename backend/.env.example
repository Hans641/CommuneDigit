# Development only. Copy to .env without overwriting existing configuration.
APP_ENV=development
DEBUG=false
SEED_DEMO_ACCOUNTS=true
PAYMENT_DEMO_ENABLED=true
DATABASE_URL=sqlite:///./communedigit.db
# Production: generate a private random key (openssl rand -hex 32).
# SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:8082

# Courrier local privé : aucun envoi externe en développement.
EMAIL_BACKEND=file
EMAIL_OUTBOX_DIR=/tmp/communedigit-mail
PUBLIC_FRONTEND_URL=http://localhost:8082
